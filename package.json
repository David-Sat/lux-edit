{
  "name": "visual-edit-monorepo",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "workbench": "pnpm --filter @visual-edit/overlay run workbench",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r exec tsc --noEmit && eslint packages --max-warnings 0",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm lint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
