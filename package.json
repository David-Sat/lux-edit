{
  "name": "visual-edit-monorepo",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run --exclude '**/.worktrees/**'",
    "lint": "pnpm -r exec tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm lint"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
